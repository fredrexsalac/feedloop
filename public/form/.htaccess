RewriteEngine On

# Handle form code in URL path
# Redirect /public/form/FORMCODE to /public/form/?code=FORMCODE
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_-]+)$ index.php?code=$1 [QSA,L]

# Optional: Handle direct access to index.php
RewriteCond %{THE_REQUEST} \s+/public/form/index\.php\?code=([^\s&]+) [NC]
RewriteRule ^ /public/form/%1? [R=301,L]
